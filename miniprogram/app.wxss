/* 全局样式 */
page {
  background-color: #1A1A2E;
  color: #EAEAEA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  min-height: 100vh;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #EAEAEA;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
}

.btn-danger {
  background: #E74C3C;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 20rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 输入框 */
.input-field {
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 6rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-seeker {
  background: rgba(255, 107, 53, 0.2);
  color: #FF6B35;
}

.tag-hider {
  background: rgba(46, 204, 113, 0.2);
  color: #2ECC71;
}

.tag-eliminated {
  background: rgba(231, 76, 60, 0.2);
  color: #E74C3C;
}

.tag-alive {
  background: rgba(46, 204, 113, 0.2);
  color: #2ECC71;
}
