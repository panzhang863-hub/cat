.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 40rpx;
}

.map-section {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.map-hint {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.map {
  width: 100%;
  height: 100%;
}

.vertex-info {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  display: flex;
  gap: 24rpx;
}

.vertex-info .link {
  color: #FF6B35;
}

.settings {
  padding: 24rpx 40rpx;
}

.setting-item {
  margin-bottom: 24rpx;
}

.setting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.setting-value {
  color: #FF8C42;
  font-weight: 700;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 4rpx;
}

.save-btn {
  margin: 0 40rpx;
}
