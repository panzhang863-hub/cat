.container {
  padding: 40rpx;
  min-height: 100vh;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.total-info {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 32rpx;
}

/* 记录卡片 */
.record-item {
  position: relative;
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-result {
  font-size: 28rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.record-result.win {
  color: #FFD700;
  background: rgba(255, 215, 0, 0.1);
}

.record-result.lose {
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
}

.record-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.record-body {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.record-tag {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-tag.alive {
  background: rgba(46, 204, 113, 0.15);
  color: #2ECC71;
}

.record-tag.eliminated {
  background: rgba(231, 76, 60, 0.15);
  color: #E74C3C;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 加载 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  padding: 32rpx 0;
}
