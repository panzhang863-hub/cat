.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* ── 地图 ── */
.game-map {
  width: 100%;
  height: 100%;
}

/* ── 顶部 HUD ── */
.hud-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
  z-index: 10;
}

.hud-left {
  display: flex;
  gap: 12rpx;
}

.role-badge {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.role-badge.seeker {
  background: rgba(255, 107, 53, 0.85);
  color: #fff;
}

.role-badge.hider {
  background: rgba(46, 204, 113, 0.85);
  color: #fff;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.status-badge.alive {
  background: rgba(46, 204, 113, 0.3);
  color: #2ECC71;
}

.status-badge.eliminated {
  background: rgba(231, 76, 60, 0.5);
  color: #E74C3C;
}

.hud-center {
  flex: 1;
  text-align: center;
}

.timer {
  font-size: 40rpx;
  font-weight: 900;
  font-family: 'Courier New', monospace;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

.timer.danger {
  color: #E74C3C;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.hud-right {
  display: flex;
  align-items: center;
}

.peek-count {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #FF8C42;
}

/* ── 查看按钮 ── */
.peek-button {
  position: absolute;
  bottom: 240rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(255, 107, 53, 0.9);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  backdrop-filter: blur(10rpx);
}

.peek-button.active {
  background: rgba(46, 204, 113, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(46, 204, 113, 0.4);
}

/* ── Peek HUD ── */
.peek-hud {
  position: absolute;
  bottom: 320rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 15;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 16rpx;
  padding: 16rpx;
  backdrop-filter: blur(10rpx);
}

.peek-header {
  font-size: 22rpx;
  color: #2ECC71;
  margin-bottom: 8rpx;
}

.peek-list {
  white-space: nowrap;
}

.peek-item {
  display: inline-block;
  background: rgba(255, 255, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
}

/* ── 抓捕弹窗 ── */
.capture-popup {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.capture-card {
  background: #1A1A2E;
  border: 2rpx solid #E74C3C;
  border-radius: 24rpx;
  padding: 48rpx;
  text-align: center;
  width: 560rpx;
  box-shadow: 0 0 40rpx rgba(231, 76, 60, 0.3);
}

.capture-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.capture-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #E74C3C;
  margin-bottom: 8rpx;
}

.capture-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.capture-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 32rpx;
}

.capture-actions {
  display: flex;
  gap: 16rpx;
}

.capture-actions button {
  flex: 1;
}

/* ── 淘汰日志 ── */
.elim-log {
  position: absolute;
  bottom: 80rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 10;
  max-height: 200rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 22rpx;
}

.log-time {
  color: rgba(255, 255, 255, 0.3);
  font-family: monospace;
}

.log-text {
  color: rgba(255, 255, 255, 0.7);
}

/* ── 游戏结束 ── */
.result-overlay {
  position: absolute;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.8);
}

.result-card {
  text-align: center;
  padding: 64rpx;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #FF6B35;
  margin-bottom: 12rpx;
}

.result-detail {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}
